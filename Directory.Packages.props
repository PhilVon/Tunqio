<Project>
  <!-- Central NuGet versions. The Windows App SDK is pinned here and nowhere else. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shell -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- E7-S3 tray (ADR-006). 2.3.2 is the newest release with a net8.0-windows build: 2.4.x ships net10.0 only. It asks for
         Windows App SDK 1.6.250108002 or later, which the 1.8 pin above satisfies. -->
    <PackageVersion Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- Host, logging, settings -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    <!-- Library -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageVersion Include="TagLibSharp" Version="2.3.0" />
    <PackageVersion Include="System.IO.Hashing" Version="8.0.0" />
    <!-- Tests and benchmarks -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- FluentAssertions 8+ moved to a paid licence for commercial use; 7.x stays Apache-2.0. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- tools/IconGen only (T-191): renders assets/brand/tunqio-icon.svg into the app's icon assets at build time; nothing
         here ships in the app. SkiaSharp is pinned at the version Svg.Skia 5.2.3 was built against. -->
    <PackageVersion Include="Svg.Skia" Version="5.2.3" />
    <PackageVersion Include="SkiaSharp" Version="4.148.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
  </ItemGroup>
</Project>
