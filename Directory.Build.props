<Project>
  <!--
    Shared build properties for every project in the repository (C# .csproj and C++ .vcxproj).
    Version and toolchain pins live here, once each (E0-S1 acceptance criterion):
      .NET SDK           -> global.json
      Windows App SDK    -> Directory.Packages.props (Microsoft.WindowsAppSDK)
      MSVC toolset       -> TunqioPlatformToolset (below)
      Windows SDK        -> TunqioWindowsSdkVersion (below)
  -->
  <PropertyGroup>
    <TunqioRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</TunqioRepoRoot>
    <TunqioVersion>0.1.0</TunqioVersion>
    <TunqioVersionMajor>$(TunqioVersion.Split('.')[0])</TunqioVersionMajor>
    <TunqioVersionMinor>$(TunqioVersion.Split('.')[1])</TunqioVersionMinor>
    <TunqioVersionPatch>$(TunqioVersion.Split('.')[2])</TunqioVersionPatch>

    <!-- Toolchain pins (see docs/build-test-release.md). -->
    <TunqioPlatformToolset>v145</TunqioPlatformToolset>
    <TunqioWindowsSdkVersion>10.0.26100.0</TunqioWindowsSdkVersion>
    <TunqioMinOsVersion>10.0.19041.0</TunqioMinOsVersion>
    <TunqioTargetFramework>net8.0-windows10.0.19041.0</TunqioTargetFramework>
  </PropertyGroup>

  <!-- C# projects only. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>$(TunqioTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(TunqioMinOsVersion)</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>$(TunqioMinOsVersion)</SupportedOSPlatformVersion>
    <!-- C# 14 for partial properties: [ObservableProperty] on a field generates CsWinRT-incompatible marshalling
         (MVVMTK0045), and the partial-property form is the toolkit's fix. Partial properties are C# 13, but the
         implementation CommunityToolkit.Mvvm 8.4.2 generates for them uses the 'field' keyword, which is C# 14;
         at 13 the generator emits nothing and every property fails with CS9248. Hence the .NET 10 SDK pin. -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned rather than latest-recommended: the analyser set is a deliberate choice, not a function of
         whichever SDK is installed. Raising it is its own change (as of .NET 10 it adds CA1873 and CA1859,
         ~96 findings), not a side effect of a toolchain bump. -->
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(TunqioRepoRoot)artifacts</ArtifactsPath>
    <!-- Solution-level dependencies on the C++ projects only order the build; without this MSBuild turns them into
         ProjectReferences and fails with MSB3851 (mpcore.dll "targets" the Windows SDK version, not the TFM). -->
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>

    <Version>$(TunqioVersion)</Version>
    <AssemblyVersion>$(TunqioVersion).0</AssemblyVersion>
    <FileVersion>$(TunqioVersion).0</FileVersion>
    <InformationalVersion>$(TunqioVersion)</InformationalVersion>
    <Product>Tunqio</Product>
    <Company>Tunqio</Company>
    <Authors>Tunqio</Authors>
    <Copyright>Copyright (c) Tunqio contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and $(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: underscores in test method names are the convention here. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and $(MSBuildProjectName.EndsWith('.Tests'))">
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>
</Project>
