<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tunqio.App.Controls.TracksList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tunqio.App.Controls"
    xmlns:lib="using:Tunqio.Core.Library">
  <!--
    The Tracks table (docs/ui-screens-and-flows.md, "Library › Tracks"): a virtualised ListView over an
    IncrementalItemsSource. Rows are fixed-height so the ItemsStackPanel can estimate the extent without
    measuring 100k items; secondary columns bind in later phases (x:Phase) so a fast scroll paints the title
    column first and fills the rest as frames allow. Sorting, the column chooser and selection actions arrive
    with E3-S8; this control is the infrastructure they sit on.
  -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="DimCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <Grid Padding="16,8,16,6" ColumnDefinitions="40,3*,2*,2*,64,56,48,88" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <TextBlock Text="#" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="2" Text="Artist" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="3" Text="Album" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="4" Text="Time" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="5" Text="Format" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="6" Text="Plays" Style="{StaticResource HeaderText}" />
      <TextBlock Grid.Column="7" Text="Rating" Style="{StaticResource HeaderText}" />
    </Grid>

    <ListView
        x:Name="List"
        Grid.Row="1"
        ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
        SelectionMode="Extended"
        IsItemClickEnabled="True"
        IncrementalLoadingTrigger="Edge"
        IncrementalLoadingThreshold="2"
        DataFetchSize="3"
        ShowsScrollingPlaceholders="True"
        ContainerContentChanging="OnContainerContentChanging">
      <ListView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel />
        </ItemsPanelTemplate>
      </ListView.ItemsPanel>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Height" Value="36" />
          <Setter Property="Padding" Value="16,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="lib:TrackDto">
          <Grid ColumnDefinitions="40,3*,2*,2*,64,56,48,88">
            <TextBlock Text="{x:Bind local:Format.TrackNo(TrackNo)}" Style="{StaticResource DimCellText}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource CellText}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ArtistNames}" Style="{StaticResource CellText}" x:Phase="1" />
            <TextBlock Grid.Column="3" Text="{x:Bind local:Format.OrEmpty(AlbumTitle)}" Style="{StaticResource CellText}" x:Phase="1" />
            <TextBlock Grid.Column="4" Text="{x:Bind local:Format.Duration(DurationMs)}" Style="{StaticResource DimCellText}" x:Phase="2" />
            <TextBlock Grid.Column="5" Text="{x:Bind local:Format.Upper(Codec)}" Style="{StaticResource DimCellText}" x:Phase="2" />
            <TextBlock Grid.Column="6" Text="{x:Bind local:Format.Plays(PlayCount)}" Style="{StaticResource DimCellText}" x:Phase="2" />
            <TextBlock Grid.Column="7" Text="{x:Bind local:Format.Rating(Rating)}" Style="{StaticResource DimCellText}" x:Phase="2" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
