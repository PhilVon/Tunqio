<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tunqio.App.Controls.TracksList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tunqio.App.Controls"
    xmlns:lib="using:Tunqio.Core.Library">
  <!--
    The Tracks table (docs/ui-screens-and-flows.md, "Library › Tracks"): a virtualised ListView over an
    IncrementalItemsSource. Rows are fixed-height so the ItemsStackPanel can estimate the extent without
    measuring 100k items; secondary columns bind in later phases (x:Phase) so a fast scroll paints the title
    column first and fills the rest as frames allow.
    E3-S8: the header cells are buttons that raise SortRequested (the page owns the query); columns other than
    the title can be hidden, which the control applies to the header and to every realised row as it is
    prepared; rows support extended selection, and a double-click, Enter (play), Shift+Enter (play next),
    Ctrl+Enter (queue) or the row menu raise ActionRequested with the selection in list order.
  -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="DimCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Padding" Value="0,2,12,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <MenuFlyout x:Name="RowMenu">
      <MenuFlyoutItem Text="Play" Click="OnMenuPlay">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Play next" Click="OnMenuPlayNext" />
      <MenuFlyoutItem Text="Add to queue" Click="OnMenuEnqueue" />
      <!-- Playlists (E6-S1) and the tag editor (E3-S10) arrive with their stories. -->
      <MenuFlyoutItem Text="Add to playlist" IsEnabled="False" />
      <MenuFlyoutItem Text="Edit tags" Click="OnMenuEditTags">
        <MenuFlyoutItem.KeyboardAccelerators>
          <KeyboardAccelerator Key="F2" IsEnabled="False" />
        </MenuFlyoutItem.KeyboardAccelerators>
      </MenuFlyoutItem>
      <MenuFlyoutSeparator />
      <MenuFlyoutItem Text="Go to album" Click="OnMenuOpenAlbum" />
      <MenuFlyoutItem Text="Go to artist" Click="OnMenuOpenArtist" />
      <MenuFlyoutItem Text="Show in folder" Click="OnMenuShowInFolder" />
    </MenuFlyout>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <Grid x:Name="Header" Padding="16,8,16,6" ColumnDefinitions="40,3*,2*,2*,64,56,48,88" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <Button Grid.Column="0" Style="{StaticResource HeaderButton}" Tag="Album" Click="OnHeaderClick" AutomationProperties.Name="Sort by track number" />
      <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Title" Click="OnHeaderClick" AutomationProperties.Name="Sort by title" />
      <Button Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Artist" Click="OnHeaderClick" AutomationProperties.Name="Sort by artist" />
      <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="Album" Click="OnHeaderClick" AutomationProperties.Name="Sort by album" />
      <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Tag="Duration" Click="OnHeaderClick" AutomationProperties.Name="Sort by duration" />
      <Button Grid.Column="5" Style="{StaticResource HeaderButton}" Tag="Codec" Click="OnHeaderClick" AutomationProperties.Name="Sort by format" />
      <Button Grid.Column="6" Style="{StaticResource HeaderButton}" Tag="PlayCount" Click="OnHeaderClick" AutomationProperties.Name="Sort by plays" />
      <Button Grid.Column="7" Style="{StaticResource HeaderButton}" Tag="Rating" Click="OnHeaderClick" AutomationProperties.Name="Sort by rating" />
    </Grid>

    <ListView
        x:Name="List"
        Grid.Row="1"
        ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
        SelectionMode="Extended"
        IsItemClickEnabled="False"
        IncrementalLoadingTrigger="Edge"
        IncrementalLoadingThreshold="2"
        DataFetchSize="3"
        ShowsScrollingPlaceholders="True"
        ContainerContentChanging="OnContainerContentChanging"
        DoubleTapped="OnDoubleTapped"
        PreviewKeyDown="OnListKeyDown"
        ContextRequested="OnContextRequested">
      <ListView.ItemsPanel>
        <ItemsPanelTemplate>
          <ItemsStackPanel />
        </ItemsPanelTemplate>
      </ListView.ItemsPanel>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Height" Value="36" />
          <Setter Property="Padding" Value="16,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="lib:TrackDto">
          <Grid
            ColumnDefinitions="40,3*,2*,2*,64,56,48,88"
            AutomationProperties.Name="{x:Bind local:Format.TrackRowName(Title, ArtistNames, AlbumTitle, DurationMs)}">
            <TextBlock Text="{x:Bind local:Format.TrackNo(TrackNo)}" Style="{StaticResource DimCellText}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource CellText}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ArtistNames}" Style="{StaticResource CellText}" x:Phase="1" />
            <TextBlock Grid.Column="3" Text="{x:Bind local:Format.OrEmpty(AlbumTitle)}" Style="{StaticResource CellText}" x:Phase="1" />
            <TextBlock Grid.Column="4" Text="{x:Bind local:Format.Duration(DurationMs)}" Style="{StaticResource DimCellText}" x:Phase="2" />
            <TextBlock Grid.Column="5" Text="{x:Bind local:Format.Upper(Codec)}" Style="{StaticResource DimCellText}" x:Phase="2" />
            <TextBlock Grid.Column="6" Text="{x:Bind local:Format.Plays(PlayCount)}" Style="{StaticResource DimCellText}" x:Phase="2" />
            <TextBlock Grid.Column="7" Text="{x:Bind local:Format.Rating(Rating)}" Style="{StaticResource DimCellText}" x:Phase="2" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</UserControl>
