<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tunqio.App: the WinUI 3 shell. Two build shapes (docs/build-test-release.md, "Build configurations"):
      unpackaged  - WindowsPackageType=None, Windows App SDK self-contained, fast F5 with mixed-mode debugging.
                    Default for Debug.
      packaged    - single-project MSIX, self-contained .NET. Default when a package is being generated
                    (GenerateAppxPackageOnBuild=true), which is how CI's package step and the release build ask
                    for it. A plain Release build stays unpackaged (T-101): the packaged assembly carries the
                    Windows App SDK deployment auto-initializer, which cannot run inside the unpackaged xunit
                    host that Tunqio.App.Tests is, so the solution build the tests run against must be the
                    unpackaged shape.
    Override with -p:TunqioPackaged=true|false.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Tunqio.App</RootNamespace>
    <AssemblyName>Tunqio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <TunqioPackaged Condition="'$(TunqioPackaged)' == '' and '$(GenerateAppxPackageOnBuild)' == 'true'">true</TunqioPackaged>
    <TunqioPackaged Condition="'$(TunqioPackaged)' == ''">false</TunqioPackaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TunqioPackaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TunqioPackaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild Condition="'$(GenerateAppxPackageOnBuild)' == ''">false</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(TunqioRepoRoot)artifacts\msix\</AppxPackageDir>
    <!-- Package file name Tunqio_<version>_x64.msix (docs/identity.md) rather than the project name. -->
    <AppxPackageName>Tunqio</AppxPackageName>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tunqio.Core\Tunqio.Core.csproj" />
    <ProjectReference Include="..\Tunqio.Interop\Tunqio.Interop.csproj" />
    <ProjectReference Include="..\Tunqio.Library\Tunqio.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <!-- The packaging targets reject an AppxManifest item when WindowsPackageType is None. -->
    <AppxManifest Include="Package.appxmanifest" Condition="'$(TunqioPackaged)' == 'true'">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="Package.appxmanifest" Condition="'$(TunqioPackaged)' != 'true'" />
    <Content Include="Assets\**\*.png" />
  </ItemGroup>

  <!-- mpcore.dll is built by native/mpcore/mpcore.vcxproj (solution build order); copy it next to the exe. -->
  <PropertyGroup>
    <TunqioNativeOut>$(TunqioRepoRoot)artifacts\native\$(Configuration)\x64\</TunqioNativeOut>
    <TunqioBassRoot>$(TunqioRepoRoot)native\bass\</TunqioBassRoot>
  </PropertyGroup>
  <Target Name="TunqioCopyNativeCore" AfterTargets="Build" Condition="Exists('$(TunqioNativeOut)mpcore.dll')">
    <ItemGroup>
      <_TunqioNativeFiles Include="$(TunqioNativeOut)mpcore.dll;$(TunqioNativeOut)mpcore.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_TunqioNativeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Third-party notices and licence texts for the About page: THIRD-PARTY-NOTICES.md plus the BASS texts
       extracted by tools/fetch-native.ps1 (when present). E0-S3. -->
  <Target Name="TunqioCopyLicenses" AfterTargets="Build">
    <ItemGroup>
      <_TunqioLicenseFiles Include="$(TunqioRepoRoot)THIRD-PARTY-NOTICES.md" />
      <_TunqioLicenseFiles Include="$(TunqioBassRoot)licenses\*.txt" />
      <_TunqioBassDlls Include="$(TunqioBassRoot)bin\x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_TunqioLicenseFiles)" DestinationFolder="$(OutDir)licenses\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TunqioBassDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_TunqioBassDlls)' != ''" />
  </Target>

</Project>
