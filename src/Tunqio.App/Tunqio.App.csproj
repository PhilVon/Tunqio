<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tunqio.App: the WinUI 3 shell. Two build shapes (docs/build-test-release.md, "Build configurations"):
      unpackaged  - WindowsPackageType=None, Windows App SDK self-contained, fast F5 with mixed-mode debugging.
                    Default for Debug.
      packaged    - single-project MSIX, self-contained .NET. Default when a package is being generated
                    (GenerateAppxPackageOnBuild=true), which is how CI's package step and the release build ask
                    for it. A plain Release build stays unpackaged (T-101): the packaged assembly carries the
                    Windows App SDK deployment auto-initializer, which cannot run inside the unpackaged xunit
                    host that Tunqio.App.Tests is, so the solution build the tests run against must be the
                    unpackaged shape.
    Override with -p:TunqioPackaged=true|false.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Tunqio.App</RootNamespace>
    <AssemblyName>Tunqio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <TunqioPackaged Condition="'$(TunqioPackaged)' == '' and '$(GenerateAppxPackageOnBuild)' == 'true'">true</TunqioPackaged>
    <TunqioPackaged Condition="'$(TunqioPackaged)' == ''">false</TunqioPackaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TunqioPackaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TunqioPackaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild Condition="'$(GenerateAppxPackageOnBuild)' == ''">false</GenerateAppxPackageOnBuild>
    <AppxPackageDir>$(TunqioRepoRoot)artifacts\msix\</AppxPackageDir>
    <!-- Package file name Tunqio_<version>_x64.msix (docs/identity.md) rather than the project name. -->
    <AppxPackageName>Tunqio</AppxPackageName>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <!-- T-131: both shapes defaulted to the <config>_<rid> pivot, so each built into the other's OutDir and left
         its files behind. The SDK fills ArtifactsPivots only when it is empty, after this file, so the packaged
         shape gets its own bin and obj. The unpackaged path is unchanged: tests and tools/check-*.ps1 use it. -->
    <ArtifactsPivots>$(Configuration.ToLowerInvariant())_$(RuntimeIdentifier)_msix</ArtifactsPivots>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tunqio.Core\Tunqio.Core.csproj" />
    <ProjectReference Include="..\Tunqio.Interop\Tunqio.Interop.csproj" />
    <ProjectReference Include="..\Tunqio.Library\Tunqio.Library.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <!-- The packaging targets reject an AppxManifest item when WindowsPackageType is None. -->
    <AppxManifest Include="Package.appxmanifest" Condition="'$(TunqioPackaged)' == 'true'">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="Package.appxmanifest" Condition="'$(TunqioPackaged)' != 'true'" />
    <Content Include="Assets\**\*.png" />
  </ItemGroup>

  <!-- The preset root the core scans: presets/ beside mpcore.dll, or MPCORE_PRESET_ROOT when it is set
       (native/mpcore/src/render/preset.cpp, default_preset_root). The repo's presets/ is committed source, so
       these are Content items rather than another AfterTargets copy: the MSIX payload is computed from item
       groups, and a file copied into $(OutDir) after the build never reaches it. LinkBase puts each file under
       presets/ with its subdirectory intact, in the unpackaged output and in the package alike.
       tools/check-presets.ps1 fails a build whose output has no preset root. -->
  <PropertyGroup>
    <TunqioPresetRoot>$(TunqioRepoRoot)presets\</TunqioPresetRoot>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(TunqioPresetRoot)**\*">
      <LinkBase>presets</LinkBase>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    T-128: the engine, its BASS runtime and the licence texts, placed as items rather than copied.

    mpcore.dll is built by native/mpcore/mpcore.vcxproj (solution build order; Tunqio.sln makes it a dependency
    of this project), and the BASS runtime it loads is fetched by tools/fetch-native.ps1. Both, and the licence
    texts under licenses/, have to be beside the exe in the unpackaged output AND inside the MSIX payload.

    Until T-128 this was two AfterTargets="Build" <Copy> targets into $(OutDir). That reaches the unpackaged
    output and nothing else: the appx layout is computed from item groups (_ComputeAppxPackagePayload gathers
    the project's content and reference outputs), and a file that only ever appears in $(OutDir) after the build
    is not in any of them. So every MSIX built up to that point carried no engine at all.

    T-125 hit the same wall for presets/ and could answer it with a static Content glob, because presets/ is
    committed source and therefore exists at evaluation time. These files do not: mpcore.dll is produced by the
    native build. The answer is the same item group, populated at execution time instead - a target that runs
    BEFORE AssignTargetPaths, which is where Content items are given the output-relative path everything
    downstream (the copy-to-output pass and the appx payload alike) reads. An item added there is
    indistinguishable from one written in the project file, so both build shapes get the same payload from one
    declaration, and the package cannot drift from the unpackaged output again.

    Missing native build: a warning unpackaged, an error packaged. Unpackaged the shell still launches and
    browses the library, and AudioStartup shows an "audio unavailable" notice (E1-S10e), which is a shape a
    developer is allowed to build. A package without the engine is not a Tunqio; it is the defect this target
    exists to end, so it fails the build instead of shipping.
  -->
  <PropertyGroup>
    <!-- T-161: opts this project into Directory.Build.targets' TunqioRefuseStaleNativeCore guard, which
         fails the build when mpcore.dll is older than a file under native/mpcore. -->
    <TunqioNeedsNativeCore>true</TunqioNeedsNativeCore>
    <TunqioNativeOut>$(TunqioRepoRoot)artifacts\native\$(Configuration)\x64\</TunqioNativeOut>
    <TunqioBassRoot>$(TunqioRepoRoot)native\bass\</TunqioBassRoot>
  </PropertyGroup>
  <Target Name="TunqioNativePayload" BeforeTargets="AssignTargetPaths">
    <Error Condition="'$(TunqioPackaged)' == 'true' and !Exists('$(TunqioNativeOut)mpcore.dll')"
           Text="mpcore.dll not found at $(TunqioNativeOut), and a package without it has no audio engine. Build the solution with msbuild (native first): msbuild Tunqio.sln -p:Configuration=$(Configuration) -p:Platform=x64" />
    <Error Condition="'$(TunqioPackaged)' == 'true' and !Exists('$(TunqioBassRoot)bin\x64\bass.dll')"
           Text="native/bass is empty, and a package without it cannot load mpcore.dll. Run tools/fetch-native.ps1 first." />
    <Warning Condition="'$(TunqioPackaged)' != 'true' and !Exists('$(TunqioNativeOut)mpcore.dll')"
             Text="mpcore.dll not found at $(TunqioNativeOut); this build of Tunqio will run without audio. Build the solution with msbuild (native first): msbuild Tunqio.sln -p:Configuration=$(Configuration) -p:Platform=x64" />
    <Warning Condition="'$(TunqioPackaged)' != 'true' and Exists('$(TunqioNativeOut)mpcore.dll') and !Exists('$(TunqioBassRoot)bin\x64\bass.dll')"
             Text="native/bass is empty; mpcore.dll will not load. Run tools/fetch-native.ps1 first." />
    <ItemGroup>
      <Content Include="$(TunqioNativeOut)mpcore.dll" Condition="Exists('$(TunqioNativeOut)mpcore.dll')">
        <Link>mpcore.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- Symbols for mixed-mode debugging, and not in the package: CI uploads mpcore.pdb beside the MSIX. -->
      <Content Include="$(TunqioNativeOut)mpcore.pdb"
               Condition="'$(TunqioPackaged)' != 'true' and Exists('$(TunqioNativeOut)mpcore.pdb')">
        <Link>mpcore.pdb</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- No Link: AssignTargetPath gives a file from outside the project cone its bare filename, which is
           where mpcore.dll looks for its BASS runtime. -->
      <Content Include="$(TunqioBassRoot)bin\x64\*.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- Third-party notices and licence texts for the About page: THIRD-PARTY-NOTICES.md plus the BASS texts
           extracted by tools/fetch-native.ps1. E0-S3; shipping them is a condition of ADR-003.
           Two steps, and an explicit Link rather than LinkBase: LinkBase is expanded by AssignLinkMetadata,
           which has already run by the time a target of this project's own hooks into AssignTargetPaths, so
           these items would land at the package root with the DLLs. %(Filename) needs a named item list to batch
           over - written straight onto a glob Include it batches over nothing and collapses all seven licences
           onto one target path (NETSDK1152). -->
      <_TunqioLicenseFile Include="$(TunqioRepoRoot)THIRD-PARTY-NOTICES.md" />
      <_TunqioLicenseFile Include="$(TunqioBassRoot)licenses\*.txt" />
      <Content Include="@(_TunqioLicenseFile)">
        <Link>licenses\%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
