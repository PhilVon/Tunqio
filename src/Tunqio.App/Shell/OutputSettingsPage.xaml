<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Shell.OutputSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Tunqio.App.Shell"
    NavigationCacheMode="Enabled">
  <!--
    Settings › Output (E6-S3). Choosing a device, the mode or the buffer reopens the output at once and a playing track
    carries on (PlaybackSession.ApplyOutputAsync). The readout is what the engine actually opened, which is not always
    what was asked for: exclusive mode is a request a driver may refuse, and the buffer in flight is not the one
    requested (T-171).
  -->
  <Page.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="16,0,16,16" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Output settings surface">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="Output" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
      <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
               Severity="Informational" IsClosable="True" Margin="0,8,0,0" AutomationProperties.AutomationId="OutputNotice" />
      <TextBlock Text="Audio is not available in this session, so there is no output to change." Style="{StaticResource Hint}"
                 Visibility="{x:Bind shell:OutputSettingsPage.Unless(ViewModel.HasAudio), Mode=OneWay}" Margin="0,8,0,0" />

      <TextBlock Text="Device" Style="{StaticResource SectionHeader}" />
      <ComboBox x:Name="DeviceList" HorizontalAlignment="Stretch" MaxWidth="480"
                ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}" SelectedItem="{x:Bind SelectedDeviceObject, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.HasAudio, Mode=OneWay}" AutomationProperties.Name="Output device" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Play test tone" Click="OnTestTone" IsEnabled="{x:Bind ViewModel.HasAudio, Mode=OneWay}"
                AutomationProperties.Name="Play test tone" ToolTipService.ToolTip="A short tone through the device above" />
        <Button Content="Use system default" Click="OnUseDefault" IsEnabled="{x:Bind ViewModel.HasAudio, Mode=OneWay}"
                AutomationProperties.Name="Use system default output"
                ToolTipService.ToolTip="For a device that has gone: play through the default without forgetting your choice" />
      </StackPanel>
      <TextBlock Text="{x:Bind ViewModel.Opened, Mode=OneWay}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                 IsTextSelectionEnabled="True" AutomationProperties.AutomationId="OutputOpened" />

      <TextBlock Text="Mode" Style="{StaticResource SectionHeader}" />
      <ToggleSwitch Header="Exclusive mode" IsOn="{x:Bind ViewModel.Exclusive, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.HasAudio, Mode=OneWay}" AutomationProperties.Name="Exclusive mode" />
      <TextBlock Text="Tunqio has the device to itself: no other app's sound, no Windows mixing. If the device will not allow it, it plays in shared mode and says so." Style="{StaticResource Hint}" />

      <TextBlock Text="Buffer" Style="{StaticResource SectionHeader}" />
      <ComboBox x:Name="BufferList" HorizontalAlignment="Stretch" MaxWidth="320"
                IsEnabled="{x:Bind ViewModel.HasAudio, Mode=OneWay}" SelectionChanged="OnBufferChosen" AutomationProperties.Name="Output buffer" />
      <TextBlock Text="Longer is steadier on a busy machine; shorter makes the controls and the visualizer feel closer to the sound." Style="{StaticResource Hint}" />
    </StackPanel>
  </ScrollViewer>
</Page>
