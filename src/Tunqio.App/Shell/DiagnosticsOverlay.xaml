<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tunqio.App.Shell.DiagnosticsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:Tunqio.App.Shell"
    mc:Ignorable="d">
  <!--
    The diagnostics overlay (E2-S8), toggled with Ctrl+Shift+D. It is also where E0-S5's renderer readout and
    E0-S3's attribution line end up: those were always a developer's text over the user's album art, and this is
    where that text belongs.

    Monospaced values, because the point of a live number is that the eye can see it change, and a proportional
    font moves every digit whenever one of them does.
  -->
  <Border Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
          BorderThickness="1" CornerRadius="8" Padding="16" MaxWidth="560"
          AutomationProperties.Name="Diagnostics">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Diagnostics" Style="{StaticResource SubtitleTextBlockStyle}" />
        <Button Grid.Column="1" x:Name="CopyButton" Click="OnCopy"
                AutomationProperties.Name="Copy diagnostics"
                ToolTipService.ToolTip="Copy everything here to the clipboard">
          <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
            <TextBlock Text="Copy" Style="{StaticResource CaptionTextBlockStyle}" />
          </StackPanel>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:DiagnosticsSection">
              <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{x:Bind Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shell:DiagnosticsRow">
                      <Grid ColumnDefinitions="150,*" ColumnSpacing="12" Padding="0,1">
                        <TextBlock Grid.Column="0" Text="{x:Bind Label}" Opacity="0.7"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- E0-S3's attribution, which the About page takes over in E6-S5. -->
      <TextBlock Grid.Row="2" x:Name="AttributionText" Style="{StaticResource CaptionTextBlockStyle}"
                 Opacity="0.6" TextWrapping="Wrap" />
    </Grid>
  </Border>
</UserControl>
