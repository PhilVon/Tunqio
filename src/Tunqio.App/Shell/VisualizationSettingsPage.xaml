<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Shell.VisualizationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Tunqio.App.Shell"
    NavigationCacheMode="Enabled">
  <!--
    Settings › Visualization (docs/ui-screens-and-flows.md; E4-S9). The preset switcher, the parameters the
    chosen preset declares, and the two audio-reactive theming settings E4-S6 shipped with no UI (T-151). Until
    E6 builds the settings overlay this lives in the library pane's frame beside Settings › Library, reached
    from the selector at the top of either page.

    Every control under "Preset options" is built from what the ABI says the preset declares
    (mp_renderer_enum_preset_params, T-142) - the label, the range, the step, the unit, and whether it is a
    slider or a list of named modes. Nothing about a preset is written down here, which is what lets a preset a
    user wrote get the controls it asked for. A parameter the manifest marks hidden gets none: Ambient Glow's
    art_primary / art_secondary / art_accent are set by code from the album art palette and carry packed sRGB
    integers, and a slider from -1 to 16777215 is not a control.

    ItemsRepeater is deliberately NOT used for either list: an x:Bind template inside one carries no DataContext,
    and both templates here bind to their own item. ItemsControl gives an x:DataType template that does.
  -->
  <Page.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Page.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <TextBlock Text="Visualization settings" Style="{StaticResource SubtitleTextBlockStyle}" Margin="16,12,16,4" />

    <!-- The two settings pages there are, until E6's overlay. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="16,4,16,4">
      <Button x:Name="LibraryTab" Content="Library" Click="OnOpenLibrarySettings"
              AutomationProperties.Name="Library settings" />
      <Button x:Name="VisualizationTab" Content="Visualization" IsEnabled="False"
              AutomationProperties.Name="Visualization settings" />
    </StackPanel>

    <!--
      Named so a harness can read its bounding rectangle and check that every control on the page is inside it
      (tools/check-visualization-settings.ps1). This surface is stretched by the pane's Frame, so its width IS
      the space the page has, and "no control extends past its right edge" is the invariant a fixed-width
      control breaks.
    -->
    <!--
      HorizontalContentAlignment="Stretch" is the half that is easy to miss: a ScrollViewer arranges its content
      at the content alignment, and the default leaves a Stretch child sitting at its desired width. Without it
      the column measured 119 px inside a 224 px panel even with HorizontalAlignment="Stretch" on the panel.
    -->
    <ScrollViewer x:Name="SettingsSurface" Grid.Row="2" Padding="16,0,16,16"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="Visualization settings surface">
      <!--
        Stretch, not Left. Left makes the panel take its DESIRED width, which in a sidebar this narrow measured
        119 px inside a 224 px content box - so the page used half the room it had and every control was laid out
        against a column narrower than the panel. Stretch fills the panel and MaxWidth stops a wide one becoming
        a 1200 px line of text. Named so the harness can read this column's rectangle: "no control extends past
        the column that lays the page out" is the invariant, and it needs the column, not the ScrollViewer.
      -->
      <StackPanel x:Name="SettingsColumn" MaxWidth="720" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Visualization settings content">
        <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
                 Severity="{x:Bind shell:VisualizationSettingsPage.SeverityOf(ViewModel.NoticeIsError), Mode=OneWay}"
                 IsClosable="True" Closed="OnNoticeClosed" Margin="0,8,0,0" />

        <TextBlock Text="The visualizer is not running, so there is nothing to choose between. It starts with the Now Playing panel; the diagnostics overlay (Ctrl+Shift+D) says why when it did not."
                   Style="{StaticResource Hint}" Margin="0,12,0,0"
                   Visibility="{x:Bind shell:VisualizationSettingsPage.Unless(ViewModel.IsAvailable), Mode=OneWay}" />

        <StackPanel Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">

          <!-- Preset -->
          <TextBlock Text="Preset" Style="{StaticResource SectionHeader}" />
          <TextBlock Text="What the Now Playing panel draws. The switch takes effect at once and is remembered for next time."
                     Style="{StaticResource Hint}" />
          <ListView x:Name="PresetList" ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                    SelectionMode="Single" Margin="0,8,0,0" MaxHeight="260"
                    AutomationProperties.Name="Presets">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="shell:PresetRow">
                <!--
                  The automation name is the preset's display name and nothing else (T-122: the Tracks rows had
                  none, and Narrator read a whole DTO out including the file path). The id underneath is for the
                  eye, and is kept out of the automation tree.
                -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="4,6"
                      AutomationProperties.Name="{x:Bind AutomationName}">
                  <FontIcon Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" AutomationProperties.AccessibilityView="Raw">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Id}" Opacity="0.6" FontSize="12" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>

          <!-- Preset options -->
          <TextBlock Text="Preset options" Style="{StaticResource SectionHeader}" />
          <TextBlock Text="This preset has nothing to adjust." Style="{StaticResource Hint}"
                     Visibility="{x:Bind shell:VisualizationSettingsPage.Unless(ViewModel.HasParameters), Mode=OneWay}" />
          <ItemsControl ItemsSource="{x:Bind ViewModel.Parameters, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="shell:PresetParameterRow">
                <Grid Margin="0,4,0,8" RowDefinitions="Auto,Auto">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{x:Bind Label}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Display, Mode=OneWay}" Opacity="0.7" />
                  </Grid>
                  <!--
                    Stretch and no Width. A fixed Width cannot shrink, so in a sidebar narrower than it the
                    control keeps its size and hangs off the right of the panel, under the controls panel -
                    which is what Phil found and what a 360 here did. There is no MaxWidth either: the column
                    above is already capped at 720, and one cap in one place is easier to keep true than a
                    number repeated on every control.
                  -->
                  <Slider Grid.Row="1" Visibility="{x:Bind IsSlider}"
                          Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}" StepFrequency="{x:Bind StepFrequency}"
                          Value="{x:Bind Value, Mode=TwoWay}" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                  <ComboBox Grid.Row="1" Visibility="{x:Bind IsChoice}"
                            ItemsSource="{x:Bind Choices}" SelectedIndex="{x:Bind SelectedChoice, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="ResetButton" Content="Reset to defaults" Click="OnReset" Margin="0,4,0,0"
                  IsEnabled="{x:Bind ViewModel.HasParameters, Mode=OneWay}"
                  AutomationProperties.Name="Reset to defaults" />

          <!-- Your presets -->
          <TextBlock Text="Your presets" Style="{StaticResource SectionHeader}" />
          <TextBlock Style="{StaticResource Hint}">
            <Run Text="A preset is a folder holding preset.json and the HLSL it names. Drop one into" />
            <Run Text="{x:Bind ViewModel.UserPresetDirectory}" FontFamily="Consolas" />
            <Run Text="and press Refresh; the visualizer keeps drawing while it rereads, and a manifest that will not parse costs you that preset and not the others." />
          </TextBlock>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh"
                    AutomationProperties.Name="Refresh presets" />
            <Button x:Name="OpenFolderButton" Content="Open folder" Click="OnOpenPresetFolder"
                    AutomationProperties.Name="Open preset folder" />
          </StackPanel>
        </StackPanel>

        <!-- Audio-reactive theming (T-151) -->
        <TextBlock Text="Audio-reactive theming" Style="{StaticResource SectionHeader}" />
        <ToggleSwitch x:Name="ReactiveThemingSwitch" Header="Let the theme follow the music"
                      IsOn="{x:Bind ViewModel.ReactiveTheming, Mode=TwoWay}"
                      AutomationProperties.Name="Let the theme follow the music" />
        <TextBlock Text="The window's background gradient takes its colour from what is playing. Off is the resting palette, and Windows' own reduced-motion and high-contrast settings turn it off whatever this says."
                   Style="{StaticResource Hint}" />
        <TextBlock Text="Smoothing" Margin="0,12,0,0" />
        <Slider x:Name="SmoothingSlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                Value="{x:Bind ViewModel.ReactiveSmoothing, Mode=TwoWay}"
                HorizontalAlignment="Stretch"
                IsEnabled="{x:Bind ViewModel.ReactiveTheming, Mode=OneWay}"
                AutomationProperties.Name="Reactive theming smoothing" />
        <!--
          The label states the time constant the setting maps to rather than showing a bare 0..1, because the
          number means something: alpha = 1 - exp(-dt / tau), tau runs 0.5 s to 4 s, and one tau covers 63% of a
          step (measured at 63.9% at all four settings in E4-S6). A slider whose only feedback is "0.35" is a
          number with no meaning outside the source.
        -->
        <TextBlock Text="{x:Bind ViewModel.SmoothingDescription, Mode=OneWay}" Style="{StaticResource Hint}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
