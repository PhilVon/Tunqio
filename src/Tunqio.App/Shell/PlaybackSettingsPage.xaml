<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Shell.PlaybackSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Tunqio.App.Shell"
    NavigationCacheMode="Enabled">
  <!--
    Settings › Playback (E6-S3). Every control writes its key as it changes, and says under it when the change is heard,
    because the session reads each at a different moment (PlaybackSettingsViewModel).
  -->
  <Page.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="16,0,16,16" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Playback settings surface">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="Playback" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />

      <TextBlock Text="Between tracks" Style="{StaticResource SectionHeader}" />
      <ToggleSwitch Header="Gapless playback" IsOn="{x:Bind ViewModel.Gapless, Mode=TwoWay}" AutomationProperties.Name="Gapless playback" />
      <TextBlock Text="Tracks from the same album follow each other with no gap and no crossfade." Style="{StaticResource Hint}" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBlock Text="Crossfade" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CrossfadeLabel, Mode=OneWay}" Opacity="0.7" />
      </Grid>
      <Slider Minimum="0" Maximum="{x:Bind shell:PlaybackSettingsViewModel.CrossfadeMaxSeconds}" StepFrequency="0.5"
              Value="{x:Bind ViewModel.CrossfadeSeconds, Mode=TwoWay}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="Crossfade seconds" />
      <TextBlock Text="Between tracks of different albums. 0 is off." Style="{StaticResource Hint}" />
      <TextBlock Text="{x:Bind shell:PlaybackSettingsViewModel.JoinTakesEffect}" Style="{StaticResource Hint}" />

      <TextBlock Text="Loudness" Style="{StaticResource SectionHeader}" />
      <ComboBox x:Name="ReplayGainMode" Header="ReplayGain" HorizontalAlignment="Stretch" MaxWidth="320"
                SelectedIndex="{x:Bind ViewModel.ReplayGainIndex, Mode=TwoWay}" AutomationProperties.Name="ReplayGain mode" />
      <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
        <TextBlock Text="Preamp" />
        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PreampLabel, Mode=OneWay}" Opacity="0.7" />
      </Grid>
      <Slider Minimum="{x:Bind shell:PlaybackSettingsViewModel.PreampMinDb}" Maximum="{x:Bind shell:PlaybackSettingsViewModel.PreampMaxDb}"
              StepFrequency="0.5" Value="{x:Bind ViewModel.PreampDb, Mode=TwoWay}" HorizontalAlignment="Stretch"
              AutomationProperties.Name="ReplayGain preamp" />
      <TextBlock Text="Added to the tagged gain. A track with a tagged peak is never raised past it, so nothing clips." Style="{StaticResource Hint}" />
      <TextBlock Text="{x:Bind shell:PlaybackSettingsViewModel.GainTakesEffect}" Style="{StaticResource Hint}" />

      <TextBlock Text="Starting up" Style="{StaticResource SectionHeader}" />
      <ToggleSwitch Header="Resume where I left off" IsOn="{x:Bind ViewModel.ResumeOnLaunch, Mode=TwoWay}" AutomationProperties.Name="Resume on launch" />
      <TextBlock Text="The queue and position are restored either way; on, the track you were playing is ready at the same place." Style="{StaticResource Hint}" />
      <TextBlock Text="{x:Bind shell:PlaybackSettingsViewModel.ResumeTakesEffect}" Style="{StaticResource Hint}" />
    </StackPanel>
  </ScrollViewer>
</Page>
