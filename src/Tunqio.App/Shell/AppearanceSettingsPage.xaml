<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Shell.AppearanceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
  <!--
    Settings › Appearance (E6-S3): the theme, which the window repaints on as soon as it is stored, and the two
    audio-reactive theming settings, moved here from Settings › Visualization where E4-S9 put them for want of this page
    (T-151). The control names are the ones tools/check-visualization-settings.ps1 and check-reactive-theming.ps1 use.
    Backdrop, the reduced-motion override and the accent source in the screen inventory have no setting keys yet.
  -->
  <Page.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Page.Resources>

  <ScrollViewer Padding="16,0,16,16" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Appearance settings surface">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />

      <TextBlock Text="Theme" Style="{StaticResource SectionHeader}" />
      <RadioButtons x:Name="ThemeChoices" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="Theme" />

      <TextBlock Text="Audio-reactive theming" Style="{StaticResource SectionHeader}" />
      <ToggleSwitch x:Name="ReactiveThemingSwitch" Header="Let the theme follow the music"
                    IsOn="{x:Bind ViewModel.ReactiveTheming, Mode=TwoWay}"
                    AutomationProperties.Name="Let the theme follow the music" />
      <TextBlock Text="The window's background gradient takes its colour from what is playing. Off is the resting palette, and Windows' own reduced-motion and high-contrast settings turn it off whatever this says."
                 Style="{StaticResource Hint}" />
      <TextBlock Text="Smoothing" Margin="0,12,0,0" />
      <Slider x:Name="SmoothingSlider" Minimum="0" Maximum="1" StepFrequency="0.05"
              Value="{x:Bind ViewModel.ReactiveSmoothing, Mode=TwoWay}"
              HorizontalAlignment="Stretch"
              IsEnabled="{x:Bind ViewModel.ReactiveTheming, Mode=OneWay}"
              AutomationProperties.Name="Reactive theming smoothing" />
      <TextBlock Text="{x:Bind ViewModel.SmoothingDescription, Mode=OneWay}" Style="{StaticResource Hint}" />

      <!-- E7-S3: ui.closeToTray and ui.minimizeToTray. Names used by tools/check-tray.ps1. -->
      <TextBlock Text="Window" Style="{StaticResource SectionHeader}" />
      <ToggleSwitch x:Name="CloseToTraySwitch" Header="Close to the tray"
                    IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}"
                    AutomationProperties.Name="Close to the tray" />
      <TextBlock Text="Closing the window hides it to the notification area and the music keeps playing. Click the Tunqio icon there to bring the window back, or choose Exit from its menu to quit."
                 Style="{StaticResource Hint}" />
      <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="Minimise to the tray" Margin="0,12,0,0"
                    IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                    AutomationProperties.Name="Minimise to the tray" />
      <TextBlock Text="Minimising the window hides it to the notification area instead of the taskbar. Click the Tunqio icon there to bring it back."
                 Style="{StaticResource Hint}" />

      <!-- E7-S4: ui.toastOnTrackChange, beside the window switches (Q-111 put window behaviour here). Name used by tools/check-toasts.ps1. -->
      <ToggleSwitch x:Name="ToastOnTrackChangeSwitch" Header="Show a notification when the track changes" Margin="0,12,0,0"
                    IsOn="{x:Bind ViewModel.ToastOnTrackChange, Mode=TwoWay}"
                    AutomationProperties.Name="Show a notification when the track changes" />
      <TextBlock Text="When a new track starts while you are using another window, or Tunqio is minimised or in the tray, a Windows notification shows its title, artist and art, with Previous, Play/Pause and Next buttons. Nothing is shown while Tunqio's window is in front or in Focus mode."
                 Style="{StaticResource Hint}" />
    </StackPanel>
  </ScrollViewer>
</Page>
