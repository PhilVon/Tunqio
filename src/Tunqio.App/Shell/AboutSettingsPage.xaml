<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Shell.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Tunqio.App.Shell"
    NavigationCacheMode="Enabled">
  <!--
    Settings › About & Diagnostics (E6-S5, docs/ui-screens-and-flows.md): the version, the licences with each text
    openable, the logs folder, the diagnostics export, the crash-reporting opt-in and the performance readout. The
    last section of the settings overlay (E6-S3). Everything shown is AboutSettingsViewModel's; this file holds the
    picker and the two folder launches, which cannot run in a test host, and the readout's on/off, which follows
    whether the page is on screen.

    Control names are what tools/check-about.ps1 walks. The text blocks that carry a value have an AutomationId
    and no Name, so their automation name is the value itself and the harness reads the number off the tree. The
    list is "Licence list", not "Licences": a section header is a text block named by its text, it comes first in
    the tree, and a search by name finds it before the control under it (T-69 hit this with "Theme").
    Nothing here has a fixed Width (the column is capped once at 720, like every other page), and the licence
    text box has a MaxHeight so the page, not the box, is what scrolls.
  -->
  <Page.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Readout" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Page.Resources>

  <ScrollViewer x:Name="SettingsSurface" Padding="16,0,16,16" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="About settings surface">
    <StackPanel x:Name="SettingsColumn" MaxWidth="720" HorizontalAlignment="Stretch"
                AutomationProperties.Name="About settings content">
      <TextBlock x:Name="Title" Text="About &amp; Diagnostics" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />

      <InfoBar IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}"
               Severity="{x:Bind shell:VisualizationSettingsPage.SeverityOf(ViewModel.NoticeIsError), Mode=OneWay}"
               IsClosable="True" Closed="OnNoticeClosed" Margin="0,8,0,0" />

      <!-- Version -->
      <TextBlock Text="Version" Style="{StaticResource SectionHeader}" />
      <TextBlock Text="{x:Bind ViewModel.VersionLine}" Style="{StaticResource BodyStrongTextBlockStyle}"
                 AutomationProperties.AutomationId="AppVersion" />
      <TextBlock Text="{x:Bind ViewModel.CoreLine}" Style="{StaticResource Readout}" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="CoreVersion" />
      <TextBlock Text="{x:Bind ViewModel.OsLine}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                 AutomationProperties.AutomationId="OsVersion" />

      <!-- Licences -->
      <TextBlock Text="Licences" Style="{StaticResource SectionHeader}" />
      <TextBlock Text="{x:Bind shell:AboutSettingsViewModel.BassAttribution}" TextWrapping="Wrap"
                 AutomationProperties.AutomationId="BassAttribution" />
      <TextBlock Text="Everything Tunqio ships with, from the third-party notices beside the executable. Choose one to read its licence." Style="{StaticResource Hint}" Margin="0,6,0,0" />
      <ListView x:Name="LicenceList" ItemsSource="{x:Bind ViewModel.Licences, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedLicence, Mode=TwoWay}"
                SelectionMode="Single" Margin="0,8,0,0" MaxHeight="220"
                AutomationProperties.Name="Licence list">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="shell:LicenceRow">
            <TextBlock Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" Padding="0,4" AutomationProperties.Name="{x:Bind Display}" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBox x:Name="LicenceTextBox" Text="{x:Bind ViewModel.LicenceText, Mode=OneWay}" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="240" Margin="0,8,0,0"
               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Licence text" />
      <Button x:Name="OpenLicencesButton" Content="Open licences folder" Click="OnOpenLicencesFolder" Margin="0,8,0,0"
              AutomationProperties.Name="Open licences folder" />

      <!-- Logs and diagnostics -->
      <TextBlock Text="Logs and diagnostics" Style="{StaticResource SectionHeader}" />
      <TextBlock Style="{StaticResource Hint}">
        <Run Text="The log is written to" />
        <Run Text="{x:Bind ViewModel.LogsDirectory}" FontFamily="Consolas" />
        <Run Text="one file a day, seven days kept. The export is a zip of those files, settings.json and a system-info.txt naming the app, core and ABI versions, the OS, the GPU and the output the engine opened - what to attach to a bug report." />
      </TextBlock>
      <ToggleSwitch x:Name="RedactSwitch" Header="Redact paths in the export"
                    IsOn="{x:Bind ViewModel.RedactPaths, Mode=TwoWay}" Margin="0,8,0,0"
                    AutomationProperties.Name="Redact paths in the export" />
      <TextBlock Text="Replaces your profile folder and your library folders with placeholders in the copied logs and settings. The originals are not touched." Style="{StaticResource Hint}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
        <Button x:Name="OpenLogsButton" Content="Open logs folder" Click="OnOpenLogsFolder"
                AutomationProperties.Name="Open logs folder" />
        <Button x:Name="ExportButton" Content="Export diagnostics…" Click="OnExport" Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.Name="Export diagnostics" />
      </StackPanel>

      <!-- Crash reporting -->
      <TextBlock Text="Crash reporting" Style="{StaticResource SectionHeader}" />
      <ToggleSwitch x:Name="CrashReportingSwitch" Header="Send crash reports"
                    IsOn="{x:Bind ViewModel.CrashReporting, Mode=TwoWay}"
                    AutomationProperties.Name="Send crash reports" />
      <TextBlock Text="{x:Bind shell:AboutSettingsViewModel.CrashReportingHint}" Style="{StaticResource Hint}"
                 AutomationProperties.AutomationId="CrashReportingHint" />

      <!-- Performance -->
      <TextBlock Text="Performance" Style="{StaticResource SectionHeader}" />
      <TextBlock Text="The same numbers as the diagnostics overlay (Ctrl+Shift+D), read twice a second while this page is open." Style="{StaticResource Hint}" />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="4" Margin="0,8,0,0">
        <TextBlock Grid.Row="0" Text="Dropouts" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Dropouts, Mode=OneWay}" Style="{StaticResource Readout}"
                   AutomationProperties.AutomationId="DropoutsReadout" />
        <TextBlock Grid.Row="1" Text="Frame time" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FrameTime, Mode=OneWay}" Style="{StaticResource Readout}"
                   AutomationProperties.AutomationId="FrameTimeReadout" />
        <TextBlock Grid.Row="2" Text="Memory" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Memory, Mode=OneWay}" Style="{StaticResource Readout}"
                   AutomationProperties.AutomationId="MemoryReadout" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
