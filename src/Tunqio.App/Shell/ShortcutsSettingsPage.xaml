<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Shell.ShortcutsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Tunqio.App.Shell"
    NavigationCacheMode="Enabled">
  <!--
    Settings › Shortcuts (E6-S4, docs/ui-screens-and-flows.md, "Keyboard shortcuts"): one row per row of the shell's
    shortcut table, built from the table itself so a command added there is on this page without a second list.
    Change records the next chord (ShortcutCaptureButton); a chord another action holds is named in a dialog and only
    taken on "use it anyway", with the other row then reading Not bound; Clear leaves a row with no key; Reset removes
    every shortcuts.* key. The shell follows the store, so a change is in force the moment the row shows it.

    ItemsControl rather than ItemsRepeater for the reason on the Visualization page: an x:Bind template in a repeater
    carries no DataContext. The row's own texts have no automation names of their own: the buttons are named per
    row ("Change Play / Pause"), and the key text carries an AutomationId (Binding.playPause) so a harness can read
    the key of a named action without knowing what it is.
  -->
  <Page.Resources>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Page.Resources>

  <ScrollViewer x:Name="SettingsSurface" Padding="16,0,16,16" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Shortcuts settings surface">
    <StackPanel x:Name="SettingsColumn" MaxWidth="720" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Shortcuts settings content">
      <TextBlock Text="Shortcuts" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
      <TextBlock Text="Press Change, then the new keys; Esc cancels. A change is in force at once. Shortcuts work from anywhere in the window except a text box."
                 Style="{StaticResource Hint}" Margin="0,6,0,8" />

      <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="shell:ShortcutRow">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Padding="0,6"
                  BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind DefaultNote, Mode=OneWay}" Style="{StaticResource Hint}"
                           Visibility="{x:Bind shell:ShortcutsSettingsPage.Unless(IsDefault), Mode=OneWay}" />
              </StackPanel>
              <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,3" CornerRadius="4"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}"
                      BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <TextBlock Text="{x:Bind Display, Mode=OneWay}" FontFamily="Consolas"
                           AutomationProperties.AutomationId="{x:Bind BindingAutomationId}" />
              </Border>
              <shell:ShortcutCaptureButton Grid.Column="2" Content="Change" MinWidth="96" Tag="{x:Bind}"
                                           Captured="OnCaptured"
                                           AutomationProperties.Name="{x:Bind ChangeAutomationName}" />
              <Button Grid.Column="3" Content="Clear" Click="OnClear" Tag="{x:Bind}"
                      IsEnabled="{x:Bind IsBound, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind ClearAutomationName}"
                      ToolTipService.ToolTip="Leave this action with no shortcut" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button x:Name="ResetButton" Content="Reset all to defaults" Click="OnReset" Margin="0,12,0,0"
              AutomationProperties.Name="Reset all shortcuts" />
      <TextBlock Text="Reset puts every action back on the key listed in the documentation and removes the stored bindings."
                 Style="{StaticResource Hint}" Margin="0,6,0,0" />
    </StackPanel>
  </ScrollViewer>
</Page>
