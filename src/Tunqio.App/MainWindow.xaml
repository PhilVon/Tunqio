<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tunqio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="*,Auto">
    <!-- The visualizer surface: the native core renders into this panel's composition swap chain (ADR-002). -->
    <SwapChainPanel x:Name="VisualizerPanel" Grid.RowSpan="2" />
    <!-- Start-up notices (E3-S1 database recovery). E2-S7 replaces this with the shell's error surfaces. -->
    <InfoBar x:Name="NoticeBar" VerticalAlignment="Top" Margin="12" IsOpen="False" />
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
      <TextBlock x:Name="ProductText" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
      <TextBlock x:Name="VersionText" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" Opacity="0.8" />
    </StackPanel>
    <StackPanel Grid.Row="1" Padding="12" Spacing="4" Background="#A0101014">
      <TextBlock x:Name="RenderText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextWrapping="Wrap" />
      <TextBlock x:Name="EngineText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
