<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tunqio.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="using:Tunqio.App.Library"
    xmlns:shell="using:Tunqio.App.Shell">
  <!--
    The shell (E2-S1). Three panels — Now Playing, the sidebar, the controls — whose shares and orientation come
    from ShellLayout rather than from AdaptiveTriggers here, because AC-68 is about the proportions and a rule
    living in a VisualState can only be checked by looking at a running window. Root carries RequestedTheme, and
    ApplyBackdrop decides its background: transparent so Mica or acrylic shows through the layered surfaces, opaque
    on a machine with neither, where something has to be painted or the theme change has nothing to repaint (AC-69).
  -->
  <!--
    AllowDrop on the root, not on a panel: anywhere on the window is the drop target (E2-S4), because a user
    dragging an album onto a music player is not aiming at a region.
  -->
  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">

    <!--
      Audio-reactive theming (E4-S6) paints its Composition gradient into this layer, which is empty and first
      so it sits behind every panel: the contract says reactive theming blends the background layer only.
      Invisible until something is playing and the switches allow it, so a window without it looks as it did.
    -->
    <Grid x:Name="ReactiveLayer" IsHitTestVisible="False" />

    <Grid x:Name="ShellGrid">

      <!-- Now Playing: the visualizer surface with the metadata block over it (E2-S3). -->
      <Grid x:Name="NowPlayingColumn">
        <!-- The native core renders into this panel's composition swap chain (ADR-002). -->
        <SwapChainPanel x:Name="VisualizerPanel" />
        <shell:NowPlayingPanel x:Name="NowPlaying" />
      </Grid>

      <!-- Sidebar: the library pane's NavigationView and page frame (E3-S8). -->
      <library:LibraryPane x:Name="SidebarPanel"
                           BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                           Background="{ThemeResource LayerFillColorDefaultBrush}" />

      <!-- Controls: the transport (E2-S2), the mode switcher (E5-S1) and the queue button (E2-S5).
           A bar under Now Playing at its natural height in every shape (T-182; ShellChrome places it), because
           as a third column it was narrower than the transport and clipped Shuffle. Named for the automation tree
           so a harness can read where it is: the sidebar beside it is a boundary with two sides, and E4-S9
           shipped a settings page that crossed the old one. -->
      <Border x:Name="ControlsPanel"
              AutomationProperties.Name="Playback controls panel"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
        <StackPanel VerticalAlignment="Center">
          <shell:TransportControls x:Name="Transport" />
          <!--
            The mode switcher (E5-S1). RadioButtons rather than three toggles: one of three is selected, and Narrator
            says so ("Focus mode, selected, 2 of 3") without a name having to carry the state.
          -->
          <RadioButtons x:Name="ModeSwitcher" HorizontalAlignment="Center" MaxColumns="3" Margin="0,0,0,8"
                        AutomationProperties.Name="Mode" SelectionChanged="OnModeSwitcherChanged">
            <RadioButton Content="Discovery" MinWidth="0" AutomationProperties.Name="Discovery mode"
                         ToolTipService.ToolTip="Discovery (Ctrl+1)" />
            <RadioButton Content="Focus" MinWidth="0" AutomationProperties.Name="Focus mode"
                         ToolTipService.ToolTip="Focus (Ctrl+2, F11; Esc leaves)" />
            <RadioButton Content="Curation" MinWidth="0" AutomationProperties.Name="Curation mode"
                         ToolTipService.ToolTip="Curation (Ctrl+3)" />
          </RadioButtons>
          <!--
            The queue lives in a flyout from this button (docs/ui-screens-and-flows.md, "Navigation map"). The
            sidebar's own Queue page waits for the Playlists section it sits beside there (E6-S1).
          -->
          <Button x:Name="QueueButton" HorizontalAlignment="Center" Margin="0,0,0,12"
                  AutomationProperties.Name="Queue" ToolTipService.ToolTip="Queue">
            <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
              <FontIcon Glyph="&#xE8FD;" FontSize="14" />
              <TextBlock Text="Queue" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="Top">
                <shell:QueuePanel x:Name="QueuePanelControl" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!--
      The error surfaces (E2-S7): start-up notices (E3-S1 database recovery, E1-S10e audio), the sticky output bar
      with its recovery action (flow 4), engine errors and scan reports. Hit-testing follows the bars themselves,
      so the empty area over the shell is not a lid on the window.
    -->
    <!--
      Focus mode (E5-S2). The announcer holds the text of the last track change announced, for a check to read. What
      Narrator hears is a UIA notification raised on the Now Playing panel; a live region here was never spoken (Q-71).
      The strip is the left edge's hit area; the peek is the queue it opens, a second QueuePanel over the same view
      model, since the button's flyout owns the first. Both are collapsed outside Focus.
    -->
    <TextBlock x:Name="TrackAnnouncer" Opacity="0" IsHitTestVisible="False" Width="1" Height="1"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               AutomationProperties.AutomationId="TrackAnnouncer" />
    <Border x:Name="QueuePeekStrip" Width="8" HorizontalAlignment="Left" Background="Transparent" Visibility="Collapsed"
            PointerEntered="OnQueuePeekStripEntered" AutomationProperties.AccessibilityView="Raw" />
    <Border x:Name="QueuePeek" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,48,0,48"
            Visibility="Collapsed" PointerExited="OnQueuePeekExited" CornerRadius="0,8,8,0" BorderThickness="0,1,1,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            AutomationProperties.Name="Queue peek">
      <shell:QueuePanel x:Name="QueuePeekPanel" />
    </Border>

    <shell:NoticePanel x:Name="Notices" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12" MaxWidth="720" />

    <!--
      The diagnostics overlay (E2-S8), Ctrl+Shift+D. It took over E0-S5's renderer readout and E0-S3's attribution
      line, which until now were drawn over the user's album art.
    -->
    <shell:DiagnosticsOverlay x:Name="Diagnostics" Visibility="Collapsed"
                              VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,64,12,12" />

    <!-- What a drag looks like while it is over the window. Hit-testing off, or it would steal its own drop. -->
    <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
            Margin="8" CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
      <TextBlock Text="Drop to play" Style="{StaticResource SubtitleTextBlockStyle}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
