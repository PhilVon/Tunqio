<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Library.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tunqio.App.Controls"
    NavigationCacheMode="Enabled">
  <!-- Library › Albums (docs/ui-screens-and-flows.md): sort, the genre / decade / format chips, and the grid. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Padding="16,12,16,8" Spacing="8">
      <TextBlock Text="Albums" Style="{StaticResource SubtitleTextBlockStyle}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox x:Name="SortBox" MinWidth="120" SelectionChanged="OnSortChanged" AutomationProperties.Name="Sort albums by" />
        <ToggleButton x:Name="DirectionToggle" Click="OnDirectionClick" IsChecked="{x:Bind ViewModel.Descending, Mode=OneWay}"
                      AutomationProperties.Name="Reverse order" ToolTipService.ToolTip="Reverse order">
          <FontIcon Glyph="&#xE8CB;" FontSize="14" />
        </ToggleButton>
        <ComboBox x:Name="GenreBox" MinWidth="130" ItemsSource="{x:Bind ViewModel.GenreOptions, Mode=OneWay}" SelectionChanged="OnGenreChanged" AutomationProperties.Name="Genre" />
        <ComboBox x:Name="DecadeBox" MinWidth="110" ItemsSource="{x:Bind ViewModel.DecadeOptions, Mode=OneWay}" SelectionChanged="OnDecadeChanged" AutomationProperties.Name="Decade" />
        <ComboBox x:Name="CodecBox" MinWidth="110" ItemsSource="{x:Bind ViewModel.CodecOptions, Mode=OneWay}" SelectionChanged="OnCodecChanged" AutomationProperties.Name="Format" />
      </StackPanel>
    </StackPanel>

    <controls:AlbumsGrid x:Name="Grid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" ActionRequested="OnAlbumAction" />

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" MaxWidth="360"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
      <TextBlock Text="No albums yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
      <TextBlock Text="Add your music folders in Settings › Library and the grid fills as the scan runs." Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</Page>
