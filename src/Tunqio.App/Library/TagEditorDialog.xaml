<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Tunqio.App.Library.TagEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:library="using:Tunqio.App.Library"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Header, Mode=OneWay}"
    PrimaryButtonText="Confirm"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
    PrimaryButtonClick="OnConfirm">
  <!--
    Both shapes of the dialog (docs/ui-screens-and-flows.md, "Tag editor dialog"). The batch shape is not a
    different layout, it is the same boxes loaded differently: a field the selection disagrees on comes back
    blank with "(multiple values)" behind it, and only boxes the user actually changed are written.

    The preview list is below the fields rather than beside them because it is the answer to "what am I about
    to change", which is a question asked after filling the boxes, not while.
  -->
  <!--
    One scrolling region, not two. This was a ScrollViewer around a StackPanel with the file list capped inside
    it, which gives the dialog a scrollbar AND the list a scrollbar, and the outer one takes the wheel first: the
    page moves when the reader meant the list to (T-138). A StackPanel measures its children with infinite height,
    so the list could never be told "you have this much room, scroll inside it" while it sat in one.
    A Grid can say that. The fields take the height they need and the list takes what is left over, so the only
    thing that scrolls is the only thing with more content than room.
  -->
  <Grid MaxHeight="520" Width="420" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="12">
      <Grid ColumnSpacing="12" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Grid.ColumnSpan="2" Header="Title"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Artist"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 Text="{x:Bind ViewModel.Artists, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="2" Grid.ColumnSpan="2" Header="Album"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 Text="{x:Bind ViewModel.AlbumTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="3" Grid.ColumnSpan="2" Header="Album artist"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 Text="{x:Bind ViewModel.AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="4" Grid.Column="0" Header="Genre"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 Text="{x:Bind ViewModel.Genres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!--
          A Grid and not a horizontal StackPanel, and no fixed widths on the boxes. The three of them used to be
          76 + 60 + 60 with two 8px gaps, which is 212 in a column that is (420 - 12) / 2 = 204 wide: eight pixels
          over, and a horizontal StackPanel does not shrink its children to fit, so Disc ran off the edge of the
          dialog and was cut (T-139). Widths that have to add up to a number derived from two other numbers are a
          sum somebody has to keep true by hand, and this one had already stopped being true.

          Sharing the column instead means the arithmetic cannot go wrong: whatever the column is, the boxes
          divide it. Year takes a little more because a four-digit year is the widest thing any of them holds.

          They carry the same placeholder as the rest. They are narrow, so "(multiple values)" is clipped in them
          — but a clipped placeholder still reads as greyed-out text that is not the value, whereas an empty box
          reads as "they all agree and it is blank", which is the opposite of the truth.
        -->
        <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Bottom">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Header="Year" InputScope="Number"
                   PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                   IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                   Text="{x:Bind ViewModel.Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Grid.Column="1" Header="Track" InputScope="Number"
                   PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                   IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                   Text="{x:Bind ViewModel.TrackNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Grid.Column="2" Header="Disc" InputScope="Number"
                   PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsBatch), Mode=OneWay}"
                   IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                   Text="{x:Bind ViewModel.DiscNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </Grid>

      <TextBlock Text="Separate several artists or genres with a semicolon."
                 Style="{ThemeResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" />

      <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
               Severity="Warning"
               IsClosable="False"
               Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

      <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="1"
                   Visibility="{x:Bind ViewModel.IsWriting, Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                 Visibility="{x:Bind ViewModel.HasProgressText, Mode=OneWay}"
                 Style="{ThemeResource CaptionTextBlockStyle}" />

    </StackPanel>

    <TextBlock Grid.Row="1" Text="Files affected" Style="{ThemeResource BodyStrongTextBlockStyle}" />

    <!--
      A ListView and not an ItemsRepeater: this list is short (a selection, not a library) and it wants the
      scrolling and the row chrome it brings. ItemsRepeater templates in this app carry no DataContext, which
      is a trap this list does not need to walk into.

      No MaxHeight: the row it sits in is the cap. A fixed 180 here was the other half of the nested-scroll
      problem, because it made the list shorter than its content while the panel around it was still free to
      grow, so both of them had something to scroll.
    -->
    <ListView Grid.Row="2"
              ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
              SelectionMode="None"
              MinHeight="96"
              IsTabStop="False">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="library:TagEditorFileRow">
            <Grid ColumnSpacing="8" Padding="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
              <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}"
                         Style="{ThemeResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>
