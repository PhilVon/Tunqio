<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Tunqio.App.Library.TagEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:library="using:Tunqio.App.Library"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.Header, Mode=OneWay}"
    PrimaryButtonText="Confirm"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanConfirm, Mode=OneWay}"
    PrimaryButtonClick="OnConfirm">
  <!--
    Both shapes of the dialog (docs/ui-screens-and-flows.md, "Tag editor dialog"). The batch shape is not a
    different layout, it is the same boxes loaded differently: a field the selection disagrees on comes back
    blank with "(multiple values)" behind it, and only boxes the user actually changed are written.

    The placeholder is only seen, never heard: WinUI keeps it in the raw automation view, which Narrator does not
    read. So each box also carries the same fact as HelpText, set while the selection disagrees and the box is
    untouched (TagEditorViewModel.IsXMixed), and empty otherwise so it is not read for a field about to be written (T-123).

    The preview list is below the fields rather than beside them because it is the answer to "what am I about
    to change", which is a question asked after filling the boxes, not while.
  -->
  <!--
    One scrolling region, not two. This was a ScrollViewer around a StackPanel with the file list capped inside
    it, which gives the dialog a scrollbar AND the list a scrollbar, and the outer one takes the wheel first: the
    page moves when the reader meant the list to (T-138). A StackPanel measures its children with infinite height,
    so the list could never be told "you have this much room, scroll inside it" while it sat in one.
    A Grid can say that. The fields take the height they need and the list takes what is left over, so the only
    thing that scrolls is the only thing with more content than room.
  -->
  <Grid MaxHeight="520" Width="420" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Spacing="12">
      <Grid ColumnSpacing="12" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <!--
            Genre takes what is left rather than half. The number boxes on the same row need a definite amount of
            room and Genre does not: it is a text box that scrolls, so being narrower costs it nothing that being
            clipped costs the boxes beside it. Star here and Auto there means the numbers are sized for what they
            hold and Genre absorbs the remainder, so there is no total for anybody to keep true (T-139).
          -->
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Grid.ColumnSpan="2" Header="Title"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsTitleMixed), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsTitleMixed), Mode=OneWay}"
                 Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Artist"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsArtistsMixed), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsArtistsMixed), Mode=OneWay}"
                 Text="{x:Bind ViewModel.Artists, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="2" Grid.ColumnSpan="2" Header="Album"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsAlbumTitleMixed), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsAlbumTitleMixed), Mode=OneWay}"
                 Text="{x:Bind ViewModel.AlbumTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="3" Grid.ColumnSpan="2" Header="Album artist"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsAlbumArtistMixed), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsAlbumArtistMixed), Mode=OneWay}"
                 Text="{x:Bind ViewModel.AlbumArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBox Grid.Row="4" Grid.Column="0" Header="Genre"
                 PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsGenresMixed), Mode=OneWay}"
                 IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                 AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsGenresMixed), Mode=OneWay}"
                 Text="{x:Bind ViewModel.Genres, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <!--
          Sized for what they hold, in a column that is Auto, so nothing can squeeze them.

          They were 76 + 60 + 60 with two 8px gaps - 212 - inside a column of (420 - 12) / 2 = 204. A horizontal
          StackPanel does not overflow visibly, it takes the shortfall out of its last child and the column clips
          what is left, which is why the right-hand boxes lost the rounding on their right edge: the corner was
          being cut off (T-139, reported by Phil looking at the screen, after two checks of mine that could not
          see it).

          Sharing that column proportionally was the first attempt and it was not enough: measured at Year 74,
          Track 57, Disc 57, it made them equal and all of them narrower, fitting the 204 exactly with no slack
          at all. Exactly-fits is one rounding error from clipping again.

          So the row asks for what it needs and Genre gives way instead. 90 + 80 + 80 with the gaps is 266 of the
          420, Genre keeps 142, and because its column is the star one it is the thing that shrinks if the dialog
          ever narrows. The boxes are the last to give rather than the first.
        -->
        <Grid Grid.Row="4" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Bottom">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="80" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Header="Year" InputScope="Number"
                   PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsYearMixed), Mode=OneWay}"
                   IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                   AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsYearMixed), Mode=OneWay}"
                   Text="{x:Bind ViewModel.Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Grid.Column="1" Header="Track" InputScope="Number"
                   PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsTrackNoMixed), Mode=OneWay}"
                   IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                   AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsTrackNoMixed), Mode=OneWay}"
                   Text="{x:Bind ViewModel.TrackNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Grid.Column="2" Header="Disc" InputScope="Number"
                   PlaceholderText="{x:Bind library:TagEditorDialog.Placeholder(ViewModel.IsDiscNoMixed), Mode=OneWay}"
                   IsReadOnly="{x:Bind ViewModel.IsWriting, Mode=OneWay}"
                   AutomationProperties.HelpText="{x:Bind library:TagEditorDialog.MixedHelp(ViewModel.IsDiscNoMixed), Mode=OneWay}"
                   Text="{x:Bind ViewModel.DiscNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      </Grid>

      <TextBlock Text="Separate several artists or genres with a semicolon."
                 Style="{ThemeResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" />

      <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
               Severity="Warning"
               IsClosable="False"
               Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

      <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="1"
                   Visibility="{x:Bind ViewModel.IsWriting, Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                 Visibility="{x:Bind ViewModel.HasProgressText, Mode=OneWay}"
                 Style="{ThemeResource CaptionTextBlockStyle}" />

    </StackPanel>

    <TextBlock Grid.Row="1" Text="Files affected" Style="{ThemeResource BodyStrongTextBlockStyle}" />

    <!--
      A ListView and not an ItemsRepeater: this list is short (a selection, not a library) and it wants the
      scrolling and the row chrome it brings. ItemsRepeater templates in this app carry no DataContext, which
      is a trap this list does not need to walk into.

      No MaxHeight: the row it sits in is the cap. A fixed 180 here was the other half of the nested-scroll
      problem, because it made the list shorter than its content while the panel around it was still free to
      grow, so both of them had something to scroll.
    -->
    <ListView Grid.Row="2"
              ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
              SelectionMode="None"
              MinHeight="96"
              IsTabStop="False">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="library:TagEditorFileRow">
            <Grid ColumnSpacing="8" Padding="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Bind Display}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}" />
              <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneWay}"
                         Style="{ThemeResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
  </Grid>
</ContentDialog>
