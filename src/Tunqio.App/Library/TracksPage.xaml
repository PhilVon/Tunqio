<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Library.TracksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tunqio.App.Controls"
    NavigationCacheMode="Disabled">
  <!--
    Library › Tracks and the views that share the table (docs/ui-screens-and-flows.md): Genre and Folder
    detail, Recently added, Recently played, Most played. The column chooser and the sort live in the view
    model; the table reports header clicks and row actions.
  -->
  <Grid RowDefinitions="Auto,*">
    <Grid Padding="16,12,16,8" ColumnDefinitions="*,Auto">
      <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <DropDownButton Grid.Column="1" Content="Columns" AutomationProperties.Name="Choose columns">
        <DropDownButton.Flyout>
          <MenuFlyout x:Name="ColumnsMenu" />
        </DropDownButton.Flyout>
      </DropDownButton>
    </Grid>

    <controls:TracksList
        x:Name="Table"
        Grid.Row="1"
        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
        SortColumn="{x:Bind ViewModel.Sort, Mode=OneWay}"
        SortDescending="{x:Bind ViewModel.Descending, Mode=OneWay}"
        CanSort="{x:Bind ViewModel.CanSort, Mode=OneWay}"
        SortRequested="OnSortRequested"
        ActionRequested="OnTrackAction" />

    <TextBlock Grid.Row="1" Text="No tracks here" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
  </Grid>
</Page>
