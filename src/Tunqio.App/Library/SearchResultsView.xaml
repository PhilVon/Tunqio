<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tunqio.App.Library.SearchResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tunqio.App.Library"
    xmlns:controls="using:Tunqio.App.Controls"
    xmlns:lib="using:Tunqio.Core.Library">
  <!--
    Search results (docs/ui-screens-and-flows.md, "Search"): one grouped ListView over the view model's
    groups (Tracks, Albums, Artists; empty groups omitted), so the arrow keys walk every result and Enter,
    Shift+Enter and Ctrl+Enter mean what they mean in the Tracks table and the Albums grid. Each group header
    carries "Show all" / "Show fewer". Rows are heterogeneous; the selector picks the template by row type.
    Esc, and Up from the first row, hand focus back to the search box through the pane.
  -->
  <UserControl.Resources>
    <CollectionViewSource x:Name="Grouped" IsSourceGrouped="True" Source="{x:Bind ViewModel.Groups, Mode=OneWay}" />

    <DataTemplate x:Key="TrackTemplate" x:DataType="lib:TrackDto">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Title}">
        <FontIcon Glyph="&#xE8D6;" FontSize="14" Opacity="0.6" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind local:SearchResultsView.TrackSubline(ArtistNames, AlbumTitle)}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{x:Bind controls:Format.Duration(DurationMs)}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="AlbumTemplate" x:DataType="lib:AlbumDto">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" AutomationProperties.Name="{x:Bind controls:Format.AlbumName(Title, AlbumArtist, Year)}">
        <Grid Width="40" Height="40" CornerRadius="4" Background="{x:Bind controls:PlaceholderArt.Brush(Title)}">
          <TextBlock Text="{x:Bind controls:PlaceholderArt.Initials(Title)}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind controls:AlbumArt.Thumbnail(ArtHash)}" Stretch="UniformToFill" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind local:SearchResultsView.AlbumSubline(AlbumArtist, Year, TrackCount)}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ArtistTemplate" x:DataType="lib:ArtistDto">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
        <Grid Width="40" Height="40" CornerRadius="20" Background="{x:Bind controls:PlaceholderArt.Brush(Name)}">
          <TextBlock Text="{x:Bind controls:PlaceholderArt.Initials(Name)}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Ellipse Width="40" Height="40">
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind controls:AlbumArt.Thumbnail(ArtHash)}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind local:ArtistsPage.Counts(AlbumCount, TrackCount)}" Opacity="0.7" FontSize="12" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <local:SearchResultTemplateSelector x:Key="Templates"
                                        Track="{StaticResource TrackTemplate}"
                                        Album="{StaticResource AlbumTemplate}"
                                        Artist="{StaticResource ArtistTemplate}" />

    <MenuFlyout x:Name="TrackMenu">
      <MenuFlyoutItem Text="Play" Click="OnTrackPlay">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Play next" Click="OnTrackPlayNext" />
      <MenuFlyoutItem Text="Add to queue" Click="OnTrackEnqueue" />
      <MenuFlyoutItem Text="Edit tags" Click="OnTrackEditTags" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem Text="Go to album" Click="OnTrackOpenAlbum" />
      <MenuFlyoutItem Text="Go to artist" Click="OnTrackOpenArtist" />
      <MenuFlyoutItem Text="Show in folder" Click="OnTrackShowInFolder" />
    </MenuFlyout>
    <MenuFlyout x:Name="AlbumMenu">
      <MenuFlyoutItem Text="Play" Click="OnAlbumPlay">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Play next" Click="OnAlbumPlayNext" />
      <MenuFlyoutItem Text="Add to queue" Click="OnAlbumEnqueue" />
      <MenuFlyoutSeparator />
      <MenuFlyoutItem Text="Open album" Click="OnAlbumOpen">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Show in folder" Click="OnAlbumShowInFolder" />
    </MenuFlyout>
    <MenuFlyout x:Name="ArtistMenu">
      <MenuFlyoutItem Text="Open artist" Click="OnArtistOpen">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
    </MenuFlyout>
  </UserControl.Resources>

  <Grid>
    <ListView
        x:Name="List"
        ItemsSource="{x:Bind Grouped.View, Mode=OneWay}"
        ItemTemplateSelector="{StaticResource Templates}"
        SelectionMode="Single"
        IsItemClickEnabled="True"
        ItemClick="OnItemClick"
        PreviewKeyDown="OnListKeyDown"
        ContextRequested="OnContextRequested"
        AutomationProperties.Name="Search results">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="48" />
          <Setter Property="Padding" Value="16,4" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate x:DataType="local:SearchGroup">
              <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="{x:Bind ToggleLabel}" Visibility="{x:Bind CanToggle}" Tag="{x:Bind Kind}" Click="OnToggleGroup" Padding="8,2" />
              </Grid>
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListView.GroupStyle>
    </ListView>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
      <TextBlock Text="No results" Opacity="0.7" HorizontalAlignment="Center" />
      <TextBlock Text="{x:Bind local:SearchResultsView.NoResultsFor(ViewModel.Results), Mode=OneWay}" Opacity="0.5" FontSize="12" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,20,0" />
  </Grid>
</UserControl>
