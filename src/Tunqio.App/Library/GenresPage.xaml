<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Library.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Tunqio.App.Controls"
    xmlns:local="using:Tunqio.App.Library"
    NavigationCacheMode="Enabled">
  <!-- Library › Genres (docs/ui-screens-and-flows.md): a tag cloud sized by track count; a tag opens the filtered Tracks view. -->
  <Grid RowDefinitions="Auto,*">
    <TextBlock Text="Genres" Style="{StaticResource SubtitleTextBlockStyle}" Margin="16,12,16,4" />

    <ScrollViewer Grid.Row="1" Padding="12,4">
      <ItemsControl ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:WrapPanel Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:GenreTag">
            <Button Content="{x:Bind Label}" FontSize="{x:Bind FontSize}" Click="OnTagClick" Background="Transparent" BorderThickness="0" Padding="8,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Text="No genres yet" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
  </Grid>
</Page>
