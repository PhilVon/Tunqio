<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Library.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tunqio.App.Library"
    NavigationCacheMode="Enabled">
  <!-- Library › Playlists (E6-S1): every playlist with its totals; a playlist opens its detail; New playlist names one and opens it. -->
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Margin="16,12,16,4">
      <TextBlock Text="Playlists" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Click="OnNewPlaylist" AutomationProperties.Name="New playlist">
        <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
          <FontIcon Glyph="&#xE710;" FontSize="12" />
          <TextBlock Text="New playlist" />
        </StackPanel>
      </Button>
    </Grid>

    <ListView x:Name="List" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" IsItemClickEnabled="True"
              SelectionMode="None" ItemClick="OnItemClick" AutomationProperties.Name="Playlists">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="56" />
          <Setter Property="Padding" Value="16,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:PlaylistRow">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
            <FontIcon Glyph="&#xE90B;" FontSize="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Detail}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" MaxWidth="360"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
      <TextBlock Text="No playlists yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
      <TextBlock Text="Make one with New playlist, or use Add to playlist on an album or a track." Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
