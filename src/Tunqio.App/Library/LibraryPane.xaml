<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tunqio.App.Library.LibraryPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tunqio.App.Library"
    PreviewKeyDown="OnPaneKeyDown">
  <!--
    The sidebar's library section (docs/ui-screens-and-flows.md, "Navigation map"): a search box in the
    header, then the eight library views in a NavigationView pane and a Frame with a back stack for the detail
    pages. Alt+Left and the pane's back button go back. The pane's settings item (and Ctrl+,) opens Settings ›
    Library in the same frame until E6 builds the settings overlay (E3-S12); after a scan or a Settings action
    that changed rows the page showing is asked to reload (ILibraryRefreshable). E3-S9: while the search box has text the results view
    replaces the frame (the page keeps its state underneath); Esc, or any navigation, clears the search. Ctrl+F
    or "/" focuses the box. E2-S1 places this pane in the shell's sidebar column and hides it in Focus mode.
  -->
  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator" />
    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
  </UserControl.KeyboardAccelerators>

  <Grid RowDefinitions="Auto,*">
    <AutoSuggestBox
        x:Name="SearchBox"
        Margin="12,8,12,4"
        PlaceholderText="Search library"
        QueryIcon="Find"
        AutomationProperties.Name="Search library"
        TextChanged="OnSearchTextChanged"
        QuerySubmitted="OnSearchSubmitted"
        PreviewKeyDown="OnSearchKeyDown" />

    <NavigationView
        x:Name="Nav"
        Grid.Row="1"
        PaneDisplayMode="LeftCompact"
        OpenPaneLength="200"
        PaneTitle="Library"
        IsSettingsVisible="True"
        IsBackButtonVisible="Visible"
        IsBackEnabled="False"
        BackRequested="OnBackRequested"
        SelectionChanged="OnSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Albums" Tag="albums">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Artists" Tag="artists">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Tracks" Tag="tracks">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Genres" Tag="genres">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Folders" Tag="folders">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="Recently added" Tag="recent-added">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Recently played" Tag="recent-played">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Most played" Tag="most-played">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Grid>
        <Frame x:Name="PageFrame" Navigated="OnNavigated" Visibility="{x:Bind local:LibraryPane.Unless(Search.IsActive), Mode=OneWay}" />
        <local:SearchResultsView x:Name="Results" ViewModel="{x:Bind Search}" Visibility="{x:Bind Search.IsActive, Mode=OneWay}"
                                 EscapeRequested="OnResultsEscape" BackToSearchRequested="OnResultsBackToSearch" />
      </Grid>
    </NavigationView>
  </Grid>
</UserControl>
