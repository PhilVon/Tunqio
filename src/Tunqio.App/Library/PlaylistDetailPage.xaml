<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tunqio.App.Library.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tunqio.App.Library"
    NavigationCacheMode="Disabled">
  <!--
    Playlist detail (E6-S1, docs/ui-screens-and-flows.md): the name and "12 tracks · 48 min", play, shuffle, rename and
    delete (confirmed), and the tracks in order. Rows reorder by dragging, or by Move up / Move down in the row menu for
    the keyboard; Delete or Remove from playlist takes the selection out. Export M3U8 is E6-S2 and pin to jump list E7.
  -->
  <Page.Resources>
    <MenuFlyout x:Name="RowMenu">
      <MenuFlyoutItem Text="Play from here" Click="OnMenuPlay">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Move up" Click="OnMenuMoveUp">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70E;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutItem Text="Move down" Click="OnMenuMoveDown">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70D;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
      <MenuFlyoutSeparator />
      <MenuFlyoutItem Text="Remove from playlist" Click="OnMenuRemove">
        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
      </MenuFlyoutItem>
    </MenuFlyout>
  </Page.Resources>

  <Grid RowDefinitions="Auto,*">
    <StackPanel Padding="16" Spacing="2">
      <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" />
      <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.7" AutomationProperties.AutomationId="PlaylistSummary" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
        <Button Style="{StaticResource AccentButtonStyle}" Click="OnPlay" IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}"
                AutomationProperties.Name="Play playlist">
          <StackPanel Orientation="Horizontal" Spacing="6" AutomationProperties.AccessibilityView="Raw">
            <FontIcon Glyph="&#xE768;" FontSize="14" />
            <TextBlock Text="Play" />
          </StackPanel>
        </Button>
        <Button Content="Shuffle" Click="OnShuffle" IsEnabled="{x:Bind ViewModel.CanPlay, Mode=OneWay}" AutomationProperties.Name="Shuffle playlist" />
        <Button Content="Rename" Click="OnRename" IsEnabled="{x:Bind local:PlaylistDetailPage.Not(ViewModel.NotFound), Mode=OneWay}" AutomationProperties.Name="Rename playlist" />
        <Button Content="Delete" Click="OnDelete" IsEnabled="{x:Bind local:PlaylistDetailPage.Not(ViewModel.NotFound), Mode=OneWay}" AutomationProperties.Name="Delete playlist" />
      </StackPanel>
    </StackPanel>

    <ListView
        x:Name="List"
        Grid.Row="1"
        SelectionMode="Extended"
        CanReorderItems="True"
        CanDragItems="True"
        AllowDrop="True"
        DragItemsCompleted="OnDragItemsCompleted"
        DoubleTapped="OnDoubleTapped"
        PreviewKeyDown="OnListKeyDown"
        ContextRequested="OnContextRequested"
        AutomationProperties.Name="Playlist tracks">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Height" Value="36" />
          <Setter Property="Padding" Value="16,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:PlaylistTrackRow">
          <Grid ColumnDefinitions="3*,2*,2*,64" AutomationProperties.Name="{x:Bind AutomationName}">
            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{x:Bind Artists}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <TextBlock Grid.Column="2" Text="{x:Bind Album}" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <TextBlock Grid.Column="3" Text="{x:Bind Duration}" Opacity="0.7" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" MaxWidth="360"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
      <TextBlock Text="{x:Bind local:PlaylistDetailPage.EmptyTitle(ViewModel.NotFound), Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
      <TextBlock Text="Add tracks with Add to playlist on an album or in the Tracks view." Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap"
                 Visibility="{x:Bind local:PlaylistDetailPage.Unless(ViewModel.NotFound), Mode=OneWay}" />
    </StackPanel>
  </Grid>
</Page>
