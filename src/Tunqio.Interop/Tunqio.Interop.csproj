<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tunqio.Interop: the only project that names mpcore.dll. LibraryImport bindings over mpcore.h, the
       ABI-checking loader, SafeHandle-style wrappers, the event trampoline and pump, and the log bridge (E0-S9). -->
  <PropertyGroup>
    <RootNamespace>Tunqio.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tunqio.Core\Tunqio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tunqio.Interop.Tests" />
    <InternalsVisibleTo Include="Tunqio.Benchmarks" />
  </ItemGroup>

</Project>
