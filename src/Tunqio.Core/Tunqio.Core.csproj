<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tunqio.Core: PlayQueue, PlaybackSession, DTOs and the contracts every other layer implements or consumes.
       No I/O, no Windows: it targets plain net8.0 so a Windows dependency cannot creep in. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetPlatformMinVersion></TargetPlatformMinVersion>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <RootNamespace>Tunqio.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tunqio.Core.Tests" />
  </ItemGroup>

</Project>
